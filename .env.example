# Copy to .env. Docker Compose uses this password to configure PostgreSQL
# and pass a DATABASE_URL connection string to the API.
ORACLE_DB_PASSWORD=replace-with-a-local-password

# Optional: an OpenAI-compatible chat-completions endpoint for formatting.
# A local model URL must be reachable from inside the API container.
ORACLE_CHAT_COMPLETIONS_URL=
ORACLE_CHAT_MODEL=
ORACLE_CHAT_API_KEY=
