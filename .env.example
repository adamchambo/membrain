# Copy to .env. Docker Compose uses this password to configure PostgreSQL
# and pass a DATABASE_URL connection string to the API.
ORACLE_DB_PASSWORD=replace-with-a-local-password

# Optional setup/export/import/deletion administration token. Keep it private.
# Supply it through X-Oracle-Setup-Token. These admin writes are disabled if unset.
ORACLE_SETUP_TOKEN=
# Direct runs default to ignored .local/config.json. Compose shares a private volume.
# ORACLE_CONFIG_FILE=/absolute/path/to/private/config.json

# Optional: an OpenAI-compatible chat-completions endpoint for formatting.
# A local model URL must be reachable from inside the API container.
ORACLE_CHAT_COMPLETIONS_URL=
ORACLE_CHAT_MODEL=
ORACLE_CHAT_API_KEY=

# Optional: compatible embeddings endpoint, e.g. a local Nomic model server.
# Pin the served weights/deployment identity and change it when weights/settings change.
# Oracle checks dimension and adds the task prefix; avoid a server that adds it twice.
ORACLE_EMBEDDINGS_URL=
ORACLE_EMBEDDING_MODEL=nomic-embed-text-v1.5
ORACLE_EMBEDDING_REVISION=
ORACLE_EMBEDDING_DIMENSIONS=768
ORACLE_EMBEDDING_API_KEY=
# For a different model, set its task prefixes explicitly (empty is allowed).
# ORACLE_EMBEDDING_DOCUMENT_PREFIX="search_document: "
# ORACLE_EMBEDDING_QUERY_PREFIX="search_query: "
